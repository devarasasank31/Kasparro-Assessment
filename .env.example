# Copy this file to `.env` and fill in values you have.
# Every variable below is OPTIONAL. The pipeline runs fully offline without them.

# ---- LLM (optional) -------------------------------------------------------
# Provider key. Leave empty to run deterministic-only screening.
LLM_API_KEY=

# Provider identifier: openai | anthropic | ollama | echo
LLM_PROVIDER=openai

# Model name, e.g. gpt-4o-mini
LLM_MODEL=gpt-4o-mini

# Provider base URL (only needed for gateways / local servers)
LLM_BASE_URL=

# ---- GitHub enrichment (optional) ----------------------------------------
# Personal access token (public_repo / read-only is enough).
# Unauthenticated calls work too but are rate limited to 60 req/h.
GITHUB_TOKEN=

# ---- Runtime tuning -------------------------------------------------------
# LLM timeout in seconds
LLM_TIMEOUT_SECONDS=30

# GitHub API timeout in seconds
GITHUB_TIMEOUT_SECONDS=10

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
